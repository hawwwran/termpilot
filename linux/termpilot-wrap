# ============================================================================
#  Sudo gate (anti-shoulder-surf, NOT cryptographic)
# ============================================================================


def require_sudo() -> bool:
    """Authenticate via sudo. Uses sudo's timestamp cache, so the user is
    only prompted once per cache window. This gate is purely a UX-level
    "you have to be at the keyboard" check; it doesn't strengthen the
    encryption (the token is just a random secret in the keyring)."""
    try:
        # `sudo -v` validates / refreshes the timestamp. Prompts if expired.
        # We inherit stdio so the user sees the prompt and types directly.
        rc = subprocess.run(
            ["sudo", "-v"],
            stdin=sys.stdin, stdout=sys.stderr, stderr=sys.stderr,
        ).returncode
        return rc == 0
    except FileNotFoundError:
        sys.stderr.write("error: sudo not found on this system; can't gate the operation\n")
        return False


def _confirm(prompt: str, default_no: bool = True) -> bool:
    suffix = "[y/N]" if default_no else "[Y/n]"
    while True:
        sys.stderr.write(f"{prompt} {suffix} ")
        sys.stderr.flush()
        line = sys.stdin.readline().strip().lower()
        if not line:
            return not default_no
        if line in ("y", "yes"): return True
        if line in ("n", "no"):  return False


