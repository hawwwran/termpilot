class Backoff:
    """Bounded exponential backoff with reset-on-success. Used by the
    uploader and input-poller threads so a relay that's been hard-down
    for hours doesn't get hammered at ~2 req/s/session.

    The cap (60s) is short enough that wrapper recovery still feels
    snappy once the relay returns; the floor (0.5s) preserves the
    original retry cadence for transient blips.
    """
    def __init__(self, base: float = 0.5, cap: float = 60.0):
        self.base = base
        self.cap = cap
        self._d = base

    def sleep(self):
        d = self._d
        time.sleep(d)
        self._d = min(self.cap, d * 2.0)

    def reset(self):
        self._d = self.base


def _happy_eyeballs_create_connection(address, timeout=None):
    """RFC 8305-lite happy-eyeballs TCP connect.

    Races every getaddrinfo result in parallel (IPv6 first, IPv4 staggered
    by 250ms) and returns the first socket that completes the TCP
    handshake. Without this, Python's stock socket.create_connection
    iterates addresses serially with the full per-address timeout — so a
    relay that publishes both A and AAAA but is unreachable over IPv6
    burns the entire register timeout (~15s) in dead silence before
    falling back to IPv4. The wrapper has no output until register
    returns, so the user sees nothing and concludes the tool is broken.
    """
    host, port = address
    try:
        infos = socket.getaddrinfo(host, port, type=socket.SOCK_STREAM)
    except socket.gaierror as e:
        raise OSError(f"DNS lookup failed for {host}: {e}") from e
    if not infos:
        raise OSError(f"no addresses for {host}:{port}")
    if len(infos) == 1:
        return socket.create_connection(address, timeout=timeout)
    infos = sorted(infos, key=lambda x: 0 if x[0] == socket.AF_INET6 else 1)
    result_q: "queue.Queue" = queue.Queue()
    cancel = threading.Event()
    per_attempt = timeout if timeout is not None else 30.0

    def _try(info, delay):
        if delay and cancel.wait(delay):
            return
        af, st, proto, _, sa = info
        s = None
        try:
            s = socket.socket(af, st, proto)
            s.settimeout(per_attempt)
            s.connect(sa)
            if cancel.is_set():
                s.close()
                return
            result_q.put(("ok", s))
        except Exception as e:
            if s is not None:
                try: s.close()
                except Exception: pass
            result_q.put(("err", e))

    for i, info in enumerate(infos):
        threading.Thread(
            target=_try, args=(info, i * 0.25), daemon=True,
        ).start()

    deadline = time.monotonic() + per_attempt
    errors = []
    pending = len(infos)
    while pending > 0:
        remaining = deadline - time.monotonic()
        if remaining <= 0:
            break
        try:
            kind, payload = result_q.get(timeout=remaining)
        except queue.Empty:
            break
        if kind == "ok":
            cancel.set()
            sock = payload
            if timeout is not None:
                sock.settimeout(timeout)
            return sock
        errors.append(payload)
        pending -= 1
    cancel.set()
    if errors:
        raise errors[-1]
    raise TimeoutError("happy_eyeballs: no address connected within timeout")


class _HEHTTPSConnection(http.client.HTTPSConnection):
    """HTTPSConnection that uses happy-eyeballs for the TCP step."""
    def connect(self):
        sock = _happy_eyeballs_create_connection(
            (self.host, self.port), timeout=self.timeout,
        )
        try:
            sock.setsockopt(socket.IPPROTO_TCP, socket.TCP_NODELAY, 1)
        except OSError:
            pass
        if self._tunnel_host:
            self.sock = sock
            self._tunnel()
            sock = self.sock
            server_hostname = self._tunnel_host
        else:
            server_hostname = self.host
        self.sock = self._context.wrap_socket(
            sock, server_hostname=server_hostname,
        )


class _HEHTTPSHandler(urllib.request.HTTPSHandler):
    def https_open(self, req):
        return self.do_open(_HEHTTPSConnection, req, context=self._context)


class Relay:
    # Cap responses to 16 MB. The legit ceiling is a single long-poll
    # batch (records[] up to ~25 entries × 256 KB after b64+JSON ≈ 8 MB).
    # Without this cap, a hostile or buggy relay could OOM the wrapper
    # by returning an unbounded body.
    MAX_RESPONSE_BYTES = 16 * 1024 * 1024

    def __init__(self, base: str, secret: str, insecure: bool = False):
        from urllib.parse import urlparse
        self.base = base.rstrip("?")
        self.secret = secret
        self.insecure = insecure
        self.ctx = ssl._create_unverified_context() if insecure else ssl.create_default_context()
        u = urlparse(self.base)
        if not u.hostname:
            raise ValueError(f"relay URL has no host: {base!r}")
        self.scheme = u.scheme or "https"
        self.host = u.hostname
        self.port = u.port or (443 if self.scheme == "https" else 80)
        # Path including the relay.php script — request paths are built
        # by appending ?op=... to this.
        self.path = u.path or "/"
        # Connection pooling: each thread (output_uploader, input_poller,
        # heartbeat, main) gets its own persistent http.client connection
        # so requests reuse the TLS handshake. urllib's build_opener does
        # NOT pool — without this, every record POST pays ~2 RTT of TLS
        # handshake, capping wrapper-side throughput at ~10 records/sec
        # on a 20 ms RTT link.
        self._tls = threading.local()

    def _new_conn(self, timeout: float):
        if self.scheme == "https":
            return _HEHTTPSConnection(self.host, self.port,
                                      context=self.ctx, timeout=timeout)
        return http.client.HTTPConnection(self.host, self.port, timeout=timeout)

    def _get_conn(self, timeout: float):
        c = getattr(self._tls, "conn", None)
        if c is None:
            c = self._new_conn(timeout)
            self._tls.conn = c
        else:
            # http.client.HTTPConnection.timeout is read each .request().
            c.timeout = timeout
        return c

    def _drop_conn(self):
        c = getattr(self._tls, "conn", None)
        if c is not None:
            try: c.close()
            except Exception: pass
        self._tls.conn = None

    def request(self, method: str, op: str, *, params=None, body=None, timeout=30.0):
        from urllib.parse import urlencode
        q = {"op": op, **{k: str(v) for k, v in (params or {}).items() if v is not None}}
        sep = "&" if "?" in self.path else "?"
        path = f"{self.path}{sep}{urlencode(q)}"

        data = json.dumps(body).encode() if body is not None else None
        headers = {"Connection": "keep-alive", "Accept": "application/json"}
        if self.secret:
            headers["Authorization"] = f"Bearer {self.secret}"
        if data is not None:
            headers["Content-Type"] = "application/json"

        # One retry on a stale keep-alive socket. After a successful
        # response or a 4xx/5xx from the server, the connection stays
        # in the thread-local for the next call.
        last_stale = None
        for attempt in range(2):
            conn = self._get_conn(timeout)
            try:
                conn.request(method, path, body=data, headers=headers)
                r = conn.getresponse()
                raw = r.read(self.MAX_RESPONSE_BYTES + 1)
                if len(raw) > self.MAX_RESPONSE_BYTES:
                    self._drop_conn()
                    raise RuntimeError(f"relay response > {self.MAX_RESPONSE_BYTES} bytes")
                if r.status >= 400:
                    # Mimic urllib.error.HTTPError so existing callers'
                    # `except urllib.error.HTTPError as e: e.code; e.read()`
                    # paths still work unchanged.
                    raise urllib.error.HTTPError(
                        f"{self.scheme}://{self.host}{path}",
                        r.status, r.reason, r.msg, io.BytesIO(raw),
                    )
                return json.loads(raw.decode("utf-8"))
            except urllib.error.HTTPError:
                raise
            except (http.client.RemoteDisconnected,
                    ConnectionResetError, BrokenPipeError,
                    http.client.BadStatusLine,
                    http.client.CannotSendRequest) as e:
                # Server closed an idle keep-alive socket. Discard and
                # retry once with a fresh connection.
                self._drop_conn()
                last_stale = e
                if attempt == 1:
                    raise
                continue
            except Exception:
                self._drop_conn()
                raise
        # Unreachable: the loop either returns or raises.
        raise last_stale if last_stale else RuntimeError("relay.request: unreachable")


def _print_startup_banner(sid: str, spool_count: int, spool_bytes: int) -> None:
    """One consolidated header before the spawned program takes over the TTY."""
    DIM = "\033[2m"
    RESET = "\033[0m"
    TITLE = "\033[1;36m"
    WARN = "\033[1;33m"
    pad = " " * len("termpilot ")
    lines = [f"{TITLE}termpilot{RESET} {DIM}session {RESET}{sid}"]

    # Show how many wrappers are already running. This banner prints
    # BEFORE write_active_json for the new session, so the count is
    # "other live wrappers" - directly the signal the user wants for
    # spotting zombie accumulation (closed-tab-but-process-still-alive).
    try:
        other_live = sum(1 for e in collect_wrapper_inventory() if e.get("alive"))
    except Exception:  # noqa: BLE001
        # collect_wrapper_inventory walks /proc + reads active.json files;
        # OSError (permissions), JSON errors, or stat races are all plausible.
        # The banner must never block startup, so swallow everything.
        other_live = None
    if other_live is not None:
        if other_live == 0:
            lines.append(f"{pad}{DIM}wrappers{RESET} (you're the first on this machine)")
        elif other_live < 3:
            lines.append(f"{pad}{DIM}wrappers{RESET} {other_live} other live")
        else:
            lines.append(
                f"{pad}{DIM}wrappers{RESET} "
                f"{WARN}{other_live} other live{RESET}"
                f" {DIM}(possible zombies; run `tp gc` to inspect){RESET}"
            )

    if spool_count:
        lines.append(
            f"{pad}{DIM}spool   {RESET}replaying {spool_count} chunk(s) "
            f"({spool_bytes} bytes)"
        )
    sys.stderr.write("\n".join(lines) + "\n")


def cmd_run(argv):
    args, cmd = parse_run_args(argv)
    # Update channel: print any pending notice (sync, 3s budget) and
    # kick off an async check that parks a notice for the *next*
    # invocation. Both no-op in dev checkouts and never raise — the
    # update channel must not block or break a session start.
    try:
        from shared import release_channel
        release_channel.handle_pending_update_notice(SCRIPT_DIR)
        release_channel.spawn_async_update_check(SCRIPT_DIR)
    except Exception:
        pass
    # Fall back to ~/.config/termpilot/relay-url if neither --relay nor
    # $TERMPILOT_RELAY was provided. Lets the binary stand alone without the
    # shell function priming TERMPILOT_RELAY.
    if not args.relay:
        try:
            with open(RELAY_URL_FILE, "r") as f:
                stored = f.read().strip()
            if stored:
                args.relay = stored
        except OSError:
            pass
    if args.help or not cmd or not args.relay:
        sys.stderr.write(USAGE)
        if not args.relay:
            sys.stderr.write(
                "\nerror: relay URL not configured.\n"
                "  Set one with:  termpilot --set-relay-url https://your.host/path\n"
                "  Or pass:       --relay <url> (or $TERMPILOT_RELAY)\n"
            )
        return 2

    # Accept either form for backwards-compat with old config files,
    # $TERMPILOT_RELAY values, and --relay flags that still carry /relay.php.
    relay_base = _normalize_relay_base(args.relay)
    relay_url, _transcript_url = _relay_endpoints(relay_base)

    auth_secret = _resolve_auth_secret(args.auth) or ""

    # TERMPILOT_TOKEN_HEX env var is an explicit override for tests / scripted use.
    # Production users go through the keyring or ~/.config/termpilot/token.
    env_hex = os.environ.get("TERMPILOT_TOKEN_HEX")
    if env_hex:
        try:
            token = crypto.hex_to_token(env_hex)
        except Exception as e:
            sys.stderr.write(f"TERMPILOT_TOKEN_HEX invalid: {e}\n")
            return 2
    else:
        token = keystore.load_token()
    if token is None:
        sys.stderr.write(
            "No token. Run `termpilot --generate-token` to create one,\n"
            "then `termpilot --show-token` to copy it to the web UI.\n"
        )
        return 2
    crypto_obj = crypto.Crypto(token)
    # SHA-256(token) as hex — shared identifier with the browser. Used to
    # bind push subscriptions on the relay (which never sees the token
    # itself, only the hash). Computed once and forgotten in this scope.
    token_hash_hex = hashlib.sha256(token).hexdigest()
    # Trigger secret/id: see lib/crypto.py:derive_trigger_secret. The
    # secret authenticates op_close (per-sid) and op_push_notify
    # (per-token-hash); the id is the public verifier the relay stores
    # at register / first push_subscribe. Both are token-derived, so
    # only an entity that has the device token can produce a valid
    # secret — RELAY_SECRET alone is insufficient.
    trigger_secret_hex = crypto.derive_trigger_secret(token).hex()
    trigger_id_hex = crypto.trigger_id_for(token).hex()

    cwd = os.getcwd()
    try:
        instance = resolve_instance(args.instance)
    except ValueError as e:
        sys.stderr.write(f"termpilot: {e}\n")
        return 2

    # ---- Resilience: per-(cwd, instance) lock, then decide sid + (maybe) splice.
    lock_fd = acquire_wrapper_lock(cwd, instance)
    if lock_fd is None and not args.force:
        sys.stderr.write(
            f"termpilot: another wrapper appears to be running in {cwd} "
            f"(instance '{instance}').\n"
            "  Close it first, pass --force to override, or pick a different "
            "--instance NAME.\n"
        )
        return 4
    if lock_fd is None:
        sys.stderr.write("termpilot: --force given; proceeding without an exclusive lock\n")

    active = read_active_json(cwd, instance)
    now_ts = int(time.time())
    prev_sid = active.get("wrapper_sid") or None
    prev_marker_b64 = active.get("marker_b64") or None
    prev_age = now_ts - int(active.get("ts") or 0) if active.get("ts") else None

    sid = None
    if (prev_sid and prev_age is not None and 0 <= prev_age <= CRASH_RECOVERY_SECS
            and os.path.isdir(sid_cache_dir(prev_sid))):
        sid = prev_sid
    # Crash-recovery: we must re-POST the byte-identical marker we sent
    # last time. AES-GCM uses a random nonce per call, so encrypting
    # b"termpilot:v1" again would produce a different ciphertext and the relay
    # would 409 ("session exists with different marker"). If the cached
    # marker is missing for some reason, abandon recovery and take a
    # fresh sid — fail open into a working state rather than spinning
    # on 409s.
    if sid is not None and not prev_marker_b64:
        log_event("recovery_no_marker", prev_sid=prev_sid)
        sid = None
    if sid is None:
        sid = os.urandom(6).hex()  # 12 hex chars
        prev_marker_b64 = None  # don't reuse a marker tied to a different sid

    cleanup_stale_sid_dirs(keep_sid=sid)
    cleanup_legacy_cwd_artifacts()

    log_event("wrapper_start", sid=sid, prev_sid=prev_sid,
              prev_age_s=prev_age, cwd_short=os.path.basename(cwd),
              instance=instance)

    # Output spool: encryption queue with crash-resilient on-disk journal.
    out_spool = OutputSpool(sid, "out")
    spool_pending = out_spool.pending_chunks()
    spool_pending_bytes = sum(len(p["plain"]) for p in spool_pending)

    title = args.title or (cmd[0] if cmd else "session")
    relay = Relay(relay_url, auth_secret, insecure=args.insecure)

    # ---- Register: encrypt meta + marker, ship public_meta as plaintext.
    cmd_str = shlex.join(cmd)
    init_cols, init_rows = cols_rows_of(sys.stdout.fileno()) if os.isatty(sys.stdout.fileno()) else (100, 30)

    meta_plain = json.dumps({
        "title": title, "cwd": cwd, "cmd": cmd_str,
        "cols": init_cols, "rows": init_rows,
    }).encode("utf-8")

    enc_meta_b64 = crypto_obj.encrypt_b64(meta_plain, crypto.aad_meta(sid))
    # Use the cached marker on crash-recovery, otherwise mint a fresh one.
    # See the "Crash-recovery" block above for why this is byte-identical.
    if prev_marker_b64:
        enc_marker_b64 = prev_marker_b64
    else:
        enc_marker_b64 = crypto_obj.encrypt_b64(b"termpilot:v1", crypto.aad_marker(sid))

    try:
        reg = relay.request("POST", "register", body={
            "session_id": sid,
            "encrypted_meta": enc_meta_b64,
            "encrypted_marker": enc_marker_b64,
            "trigger_id_hex": trigger_id_hex,
            # public_meta — ONLY what the server legitimately needs to operate.
            "cols": init_cols, "rows": init_rows,
        }, timeout=15)
    except (urllib.error.URLError, urllib.error.HTTPError) as e:
        sys.stderr.write(f"termpilot: register failed: {e}\n")
        release_wrapper_lock(lock_fd)
        return 1
    if reg.get("session_id") != sid:
        sys.stderr.write(f"termpilot: register returned unexpected sid {reg}\n")
        release_wrapper_lock(lock_fd)
        return 1
    _print_startup_banner(sid, len(spool_pending), spool_pending_bytes)

    # Persist our wrapper_sid (and the marker we successfully registered
    # with) so a subsequent crash-restart can pick up the spool and
    # re-POST the same marker bytes.
    write_active_json(cwd, instance, wrapper_sid=sid, marker_b64=enc_marker_b64)

    pid, master = pty.fork()
    if pid == 0:
        # Scrub wrapper-only env from the spawned subprocess. TERMPILOT_TOKEN_HEX
        # is documented as test-only but pty.fork()+execvp inherits the
        # full env, which would expose the token to anything the child
        # later spawns. TERMPILOT_SECRET and TERMPILOT_RELAY similarly leak relay
        # credentials. Best-effort: a hostile env-reader before this point
        # still loses (the wrapper hasn't yet handed control over).
        for _v in ("TERMPILOT_TOKEN_HEX", "TERMPILOT_SECRET", "TERMPILOT_RELAY"):
            os.environ.pop(_v, None)
        try:
            os.execvp(cmd[0], cmd)
        except OSError as e:
            sys.stderr.write(f"termpilot: exec {cmd[0]} failed: {e}\n")
            os._exit(127)

    stdin_fd = sys.stdin.fileno()
    stdout_fd = sys.stdout.fileno()
    is_tty_in = os.isatty(stdin_fd) and not args.no_local

    if os.isatty(stdout_fd):
        set_winsize(master, get_winsize(stdout_fd))

    def on_winch(signum, frame):
        if os.isatty(stdout_fd):
            ws = get_winsize(stdout_fd)
            set_winsize(master, ws)
            rows, cols, _, _ = struct.unpack("HHHH", ws)
            # Push public size to the relay so browsers can match xterm cols.
            # trigger_secret_hex proves token possession — the relay refuses
            # resize from a bare RELAY_SECRET-holder (defense against a
            # co-tenant mutating someone else's session metadata).
            threading.Thread(target=lambda: _safely(
                relay.request, "POST", "resize",
                body={"session_id": sid, "cols": cols, "rows": rows,
                      "trigger_secret_hex": trigger_secret_hex},
                timeout=5,
            ), daemon=True).start()
            try: os.kill(pid, signal.SIGWINCH)
            except ProcessLookupError: pass

    signal.signal(signal.SIGWINCH, on_winch)

    # Trip on terminal close (SIGHUP) or `kill <wrapperpid>` (SIGTERM)
    # so the main loop drops out cleanly and the finally clause gets to
    # POST ?op=close. Without this, Python's default for SIGHUP is to
    # terminate the process outright — `finally` never runs, the relay
    # never hears the session ended, and the browser keeps showing a
    # greyed "offline" pill until the alive TTL eventually expires.
    shutdown_requested = threading.Event()

    def _on_term_signal(signum, frame):
        shutdown_requested.set()

    for _term_sig in (signal.SIGHUP, signal.SIGTERM):
        try:
            signal.signal(_term_sig, _on_term_signal)
        except (ValueError, OSError):
            # Best-effort: some platforms / non-main threads can't set
            # this; the default-terminate behaviour is the fallback.
            pass

    old_settings = None
    if is_tty_in:
        try:
            old_settings = termios.tcgetattr(stdin_fd)
            tty.setraw(stdin_fd)
        except termios.error:
            old_settings = None

    stop = threading.Event()

    # ---- Output uploader ---------------------------------------------------
    # PTY bytes land in out_buf (memory). The uploader thread debounces, then
    # appends each chunk as a plaintext entry to out_spool BEFORE encrypting
    # and POSTing. The spool entry is the durable record: even if we SIGKILL
    # between append and successful POST, the bytes are recoverable on the
    # next start (provided the same sid is reused — see CRASH_RECOVERY_SECS).
    out_buf = bytearray()
    out_lock = threading.Lock()
    out_event = threading.Event()

    # Pending = list of {plain, end_off}: on-disk plaintext awaiting POST.
    # Initialised from the spool (replays anything the previous run didn't
    # confirm), then we append new entries as PTY bytes arrive.
    pending = list(spool_pending)
    next_seq = out_spool.next_seq()
    if pending and pending[0]["end_off"] <= out_spool.cursor():
        # Defensive: cursor is inside or past the first pending entry. Drop.
        pending = [p for p in pending if p["end_off"] > out_spool.cursor()]

    def output_uploader():
        nonlocal next_seq
        backoff = Backoff(base=0.5, cap=60.0)
        while not stop.is_set():
            # If pending is empty, wait for new PTY data and capture a chunk.
            if not pending:
                out_event.wait(timeout=0.1)
                out_event.clear()
                with out_lock:
                    if not out_buf:
                        continue
                    chunk = bytes(out_buf)
                    out_buf.clear()
                end_off = out_spool.append(chunk)
                pending.append({"plain": chunk, "end_off": end_off})

            first = pending[0]
            seq = next_seq
            try:
                blob_b64 = crypto_obj.encrypt_b64(
                    first["plain"], crypto.aad_record("out", sid, seq),
                )
                if os.environ.get("TERMPILOT_DEBUG"):
                    sys.stderr.write(f"[upload] seq={seq} bytes={len(first['plain'])}\n")
                relay.request("POST", "output", body={
                    "session_id": sid,
                    "records": [{"seq": seq, "blob": blob_b64}],
                }, timeout=30)
                # Confirmed: drop from pending, advance cursor + next_seq.
                pending.pop(0)
                out_spool.confirm_through(first["end_off"])
                next_seq = seq + 1
                out_spool.write_next_seq(next_seq)
                backoff.reset()
            except urllib.error.HTTPError as e:
                if e.code == 409:
                    # Server says expected_seq is X. Drop pending entries the
                    # server already accepted (seq < expected_seq); keep the
                    # rest and resume at expected_seq.
                    # Bounded read: a hostile relay could otherwise ship an
                    # unbounded body on 409 and OOM the wrapper. 64 KiB is
                    # ~3 orders of magnitude over the legit payload (a tiny
                    # JSON {expected_seq, got_seq, error}).
                    try:
                        info = json.loads(e.read(65536).decode("utf-8"))
                        expected = int(info.get("expected_seq", seq + 1))
                    except Exception:
                        expected = seq + 1
                    drop = max(0, expected - seq)
                    for _ in range(drop):
                        if not pending: break
                        gone = pending.pop(0)
                        out_spool.confirm_through(gone["end_off"])
                    next_seq = expected
                    out_spool.write_next_seq(next_seq)
                    if os.environ.get("TERMPILOT_DEBUG"):
                        sys.stderr.write(f"[upload] 409 → drop={drop} next_seq={next_seq}\n")
                    backoff.reset()  # 409 is server-controlled progress, not failure
                else:
                    if os.environ.get("TERMPILOT_DEBUG"):
                        sys.stderr.write(f"[upload] HTTP {e.code}, retrying\n")
                    backoff.sleep()
            except Exception as e:
                if os.environ.get("TERMPILOT_DEBUG"):
                    sys.stderr.write(f"[upload] {type(e).__name__}: {e}, retrying\n")
                backoff.sleep()
        # Final flush: pull anything still in out_buf into the spool, then
        # try (best-effort, short timeout) to drain pending one more time.
        with out_lock:
            tail = bytes(out_buf); out_buf.clear()
        if tail:
            end_off = out_spool.append(tail)
            pending.append({"plain": tail, "end_off": end_off})
        for first in list(pending):
            seq = next_seq
            try:
                blob_b64 = crypto_obj.encrypt_b64(
                    first["plain"], crypto.aad_record("out", sid, seq),
                )
                relay.request("POST", "output", body={
                    "session_id": sid,
                    "records": [{"seq": seq, "blob": blob_b64}],
                }, timeout=5)
                pending.pop(0)
                out_spool.confirm_through(first["end_off"])
                next_seq = seq + 1
                out_spool.write_next_seq(next_seq)
            except Exception:
                break

    # ---- Input long-poller -------------------------------------------------
    def input_poller():
        # Cursor is advanced ONLY by successfully decrypted records. A bad
        # record (failed AEAD) stops the loop at that seq and retries on
        # the next poll — a hostile relay could otherwise inject a bogus
        # record at seq=N to make the wrapper permanently skip past N,
        # censoring whatever the browser sends. The trade-off: a single
        # genuinely-broken record stalls input until the user reloads.
        # The wedge is loud (stderr + events.log) so it's never silent.
        # Same reason we ignore the relay-supplied next_seq: trusting it
        # would let the server leap the cursor forward arbitrarily.
        next_seq = 0
        backoff = Backoff(base=1.0, cap=60.0)
        wedged_seq = -1  # the seq we're currently stalled on, for log dedup
        while not stop.is_set():
            try:
                j = relay.request("GET", "input", params={
                    "session": sid, "since_seq": next_seq,
                }, timeout=40)
                backoff.reset()
            except Exception:
                if stop.is_set(): return
                backoff.sleep()
                continue
            for rec in j.get("records") or []:
                seq = int(rec.get("seq", -1))
                blob_b64 = rec.get("blob") or ""
                if seq < 0 or not blob_b64:
                    continue
                if seq != next_seq:
                    # Out-of-order record. Ignore; the relay is the only
                    # entity that can advance the cursor, and we trust
                    # only AEAD-validated bytes for that.
                    continue
                try:
                    plaintext = crypto_obj.decrypt_b64(
                        blob_b64, crypto.aad_record("in", sid, seq),
                    )
                except Exception:
                    # Tag mismatch / wrong key. Surface loudly and
                    # do NOT advance the cursor — the next poll will
                    # ask for the same seq again. A persistent bad
                    # record stalls input here until the wrapper is
                    # restarted; the user sees the stderr line.
                    if seq != wedged_seq:
                        wedged_seq = seq
                        log_event("input_wedge", sid=sid, seq=seq)
                        sys.stderr.write(
                            f"termpilot: input wedged at seq={seq} "
                            "(decrypt failed; refusing to skip — restart wrapper "
                            "or check the browser is using the right token)\n"
                        )
                    break
                wedged_seq = -1
                try:
                    os.write(master, plaintext)
                except OSError:
                    return
                next_seq = seq + 1

    # ---- Local input poller -----------------------------------------------
    # A second input ingress, parallel to the relay path above. Reads plain
    # bytes appended to ~/.cache/termpilot/sid/<sid>/in.local by a sibling
    # process on this machine and types them into the PTY. Used by the
    # termpilot_mcp server and `tp send <sid> "..."` for same-machine
    # orchestration (boss-Claude prompting worker-Claude) without a relay
    # round-trip. Plain bytes; no crypto, no AAD seq, because (a) the file
    # is mode 0600 in a user-private cache dir, same trust boundary as the
    # token, and (b) the relay never sees these bytes so phone/browser
    # views stay clean. Cursor file persists across wrapper restarts so a
    # crash-recovery resume doesn't replay bytes already delivered.
    def local_input_poller():
        path = os.path.join(sid_cache_dir(sid), "in.local")
        cursor_path = path + ".cursor"
        try:
            if not os.path.exists(path):
                with open(path, "ab"):
                    pass
                try: os.chmod(path, 0o600)
                except OSError: pass
        except OSError:
            return
        # Starting cursor: persisted cursor if it exists (resume), else the
        # current file size (fresh sid: don't replay stray bytes from an
        # unrelated previous wrapper at the same path).
        try:
            with open(cursor_path, "rb") as cf:
                buf = cf.read(8)
                cursor = int.from_bytes(buf, "little") if len(buf) == 8 else 0
        except OSError:
            try: cursor = os.path.getsize(path)
            except OSError: cursor = 0
        log_event("local_input_ready", sid=sid, path=path, start_cursor=cursor)
        while not stop.is_set():
            try:
                size = os.path.getsize(path)
            except OSError:
                if stop.wait(0.25): return
                continue
            if size < cursor:
                # External truncation. Resync to the current end without
                # replaying. The user clearly wants the file empty.
                cursor = size
            if size > cursor:
                try:
                    with open(path, "rb") as f:
                        f.seek(cursor)
                        new_bytes = f.read(size - cursor)
                except OSError:
                    new_bytes = b""
                if new_bytes:
                    try:
                        os.write(master, new_bytes)
                    except OSError:
                        return
                    cursor += len(new_bytes)
                    try:
                        tmp = cursor_path + ".tmp"
                        with open(tmp, "wb") as cf:
                            cf.write(cursor.to_bytes(8, "little"))
                        os.replace(tmp, cursor_path)
                        try: os.chmod(cursor_path, 0o600)
                        except OSError: pass
                    except OSError:
                        pass
                    log_event("local_input", sid=sid, n=len(new_bytes))
            if stop.wait(0.1):
                return

    # ---- Heartbeat ---------------------------------------------------------
    def heartbeat():
        while not stop.is_set():
            time.sleep(15)
            if stop.is_set(): return
            _safely(relay.request, "POST", "heartbeat",
                    body={"session_id": sid,
                          "trigger_secret_hex": trigger_secret_hex},
                    timeout=10)

    threading.Thread(target=output_uploader, daemon=True).start()
    threading.Thread(target=input_poller, daemon=True).start()
    if not args.no_local_input:
        threading.Thread(target=local_input_poller, daemon=True).start()
    threading.Thread(target=heartbeat, daemon=True).start()

    # ---- Main loop ---------------------------------------------------------
    fds = [master]
    if is_tty_in: fds.append(stdin_fd)
    try:
        while not shutdown_requested.is_set():
            try:
                r, _, _ = select.select(fds, [], [], 1.0)
            except InterruptedError:
                # A SIGHUP/SIGTERM lands here too; the while-check above
                # catches it next iteration. Other signals (e.g. SIGWINCH)
                # just resume normally.
                continue
            except OSError as e:
                if e.errno == errno.EBADF: break
                raise
            if master in r:
                try: data = os.read(master, 65536)
                except OSError: data = b""
                if not data: break
                try: os.write(stdout_fd, data)
                except OSError: pass
                with out_lock: out_buf.extend(data)
                out_event.set()
            if is_tty_in and stdin_fd in r:
                try: data = os.read(stdin_fd, 65536)
                except OSError: data = b""
                if not data:
                    fds.remove(stdin_fd); is_tty_in = False; continue
                try: os.write(master, data)
                except OSError: break
    finally:
        stop.set(); out_event.set()
        if old_settings is not None:
            try: termios.tcsetattr(stdin_fd, termios.TCSADRAIN, old_settings)
            except termios.error: pass
        # On terminal-close the kernel already sent SIGHUP to the whole
        # foreground process group (child included). On a bare
        # `kill <wrapperpid>` it didn't — the PTY child is still alive
        # and would block the waitpid below forever. Re-send SIGHUP to
        # be sure; harmless if the child has already exited.
        if shutdown_requested.is_set():
            try: os.kill(pid, signal.SIGHUP)
            except (OSError, ProcessLookupError): pass
        _safely(relay.request, "POST", "close",
                body={"session_id": sid,
                      "trigger_secret_hex": trigger_secret_hex},
                timeout=5)
        try: os.waitpid(pid, 0)
        except ChildProcessError: pass
        # Inspect the spool BEFORE we touch active.json — if entries
        # remain, we want the next termpilot in this cwd to recover
        # them, which requires wrapper_sid + marker_b64 to stay put.
        try:
            leftover = out_spool.pending_chunks()
        except Exception:
            leftover = []
        try: out_spool.close()
        except Exception: pass

        try:
            cur = read_active_json(cwd, instance)
            if leftover:
                # Preserve recovery state: keep wrapper_sid + marker_b64 +
                # update ts so the next start (within CRASH_RECOVERY_SECS)
                # reuses the sid and replays the pending chunks.
                cur["ts"] = int(time.time())
                cur.pop("pid", None)
            else:
                # Clean exit: drop wrapper_sid (and the cached marker)
                # so the next start picks a fresh sid.
                cur.pop("wrapper_sid", None)
                cur.pop("marker_b64", None)
                cur.pop("pid", None)
                cur["ts"] = int(time.time())
            d = cwd_cache_dir(cwd, instance)
            try: os.makedirs(d, mode=0o700, exist_ok=True)
            except OSError: pass
            try:
                p = os.path.join(d, "active.json")
                tmp = p + ".tmp"
                with open(tmp, "w") as f:
                    json.dump(cur, f); f.flush()
                os.replace(tmp, p)
                try: os.chmod(p, 0o600)
                except OSError: pass
            except OSError: pass
        except Exception:
            pass

        if leftover:
            log_event("preserve_spool_on_exit", sid=sid, pending=len(leftover))
        else:
            try: shutil.rmtree(sid_cache_dir(sid))
            except OSError: pass
        release_wrapper_lock(lock_fd)
    return 0


def _safely(fn, *args, **kwargs):
    try: return fn(*args, **kwargs)
    except Exception: return None


# ============================================================================
#  termpilot_mcp activation: one-shot venv + Claude Code registration
# ============================================================================
#
# Same probe pattern as the wrapper's own sys.path setup at startup: look
# for termpilot_mcp/ next to the wrapper (release-zip flat layout) or one
# level up (dev-tree layout where the wrapper sits in linux/).
def _locate_termpilot_mcp() -> str | None:
    for cand in (
        os.path.join(SCRIPT_DIR, "termpilot_mcp"),
        os.path.realpath(os.path.join(SCRIPT_DIR, "..", "termpilot_mcp")),
    ):
        if os.path.isdir(cand):
            return cand
    return None


MCP_VENV_DEFAULT = os.path.expanduser("~/.local/share/termpilot/mcp-venv")

# Marker file recording user intent ("MCP has been activated"). Lives
# under ~/.config/ so it survives install.sh wiping ~/.local/share/
# during upgrades, letting install.sh rebuild a fresh venv against the
# new wrapper. Venv presence is too noisy a signal — it can be wiped
# legitimately (release upgrade) or missing legitimately (never opted
# in), and the two cases need opposite responses.
MCP_ACTIVE_MARKER = os.path.expanduser("~/.config/termpilot/mcp-active")


def _maybe_reexec_in_mcp_venv(argv):
    """Re-exec the wrapper under the activate-mcp venv's Python.

    The wrapper's shebang is system Python, which on PEP 668-protected
    distros (Debian/Ubuntu/Zorin) can't have `mcp` or `pyte` installed.
    The venv built by `termpilot --activate-mcp` has both. For MCP-side
    subcommands (ls / tail / screenshot / send / wait / mcp-serve) we
    transparently re-exec into the venv so the relevant imports work
    without the user thinking about Python interpreters.

    No-op if the venv doesn't exist yet (subcommands that don't need
    third-party deps still run; ones that do print a clear
    "run --activate-mcp first" message). No-op if we're already
    running under the venv interpreter.

    Loop guard: we compare sys.prefix (the venv root) rather than
    sys.executable. Venv pythons are usually symlinks to the system
    interpreter, so realpath(sys.executable) collapses them onto the
    same /usr/bin/pythonX.Y and the naive check fires on every entry.
    sys.prefix is the venv directory itself; that's the canonical
    "am I inside this venv" signal.
    """
    venv_python = os.path.join(MCP_VENV_DEFAULT, "bin", "python")
    if not os.path.isfile(venv_python):
        return
    # os.path.realpath doesn't raise for non-existent paths, so this is
    # a simple equality check on the resolved venv root.
    if os.path.realpath(sys.prefix) == os.path.realpath(MCP_VENV_DEFAULT):
        return
    os.execv(
        venv_python,
        [venv_python, os.path.realpath(__file__)] + list(argv),
    )


# Per-client MCP registration recipes. Each spec describes how to add /
# remove a server with that client's CLI. `scope` is only meaningful for
# clients that support it (Claude Code does; Codex CLI doesn't expose one
# in the canonical syntax). `manual_hint` is the fallback we print when
# the canonical command fails - the user's client version may have a
# different mcp subcommand or no mcp subcommand at all (older releases).
def _mcp_client_specs(venv_python, wrap_real, claude_scope):
    return [
        {
            "name": "Claude Code",
            "bin_name": "claude",
            "remove_argv": lambda binp: [
                binp, "mcp", "remove", "termpilot", "-s", claude_scope,
            ],
            "add_argv": lambda binp: [
                binp, "mcp", "add", "termpilot", "-s", claude_scope, "--",
                venv_python, wrap_real, "mcp-serve",
            ],
            "scope_note": f" (scope: {claude_scope})",
            "manual_hint": (
                "  Manual setup: add to ~/.claude/mcp.json:\n"
                "    {\n"
                '      "mcpServers": {\n'
                '        "termpilot": {\n'
                f'          "command": "{venv_python}",\n'
                f'          "args": ["{wrap_real}", "mcp-serve"]\n'
                "        }\n"
                "      }\n"
                "    }\n"
            ),
        },
        {
            "name": "Codex CLI",
            "bin_name": "codex",
            "remove_argv": lambda binp: [binp, "mcp", "remove", "termpilot"],
            "add_argv": lambda binp: [
                binp, "mcp", "add", "termpilot", "--",
                venv_python, wrap_real, "mcp-serve",
            ],
            "scope_note": "",
            "manual_hint": (
                "  Manual setup: add to ~/.codex/config.toml:\n"
                "    [mcp_servers.termpilot]\n"
                f'    command = "{venv_python}"\n'
                f'    args = ["{wrap_real}", "mcp-serve"]\n'
                "  (Both the `codex mcp` subcommand and the TOML schema key\n"
                "  shown above vary across Codex CLI versions; run `codex\n"
                "  mcp --help` and check the docs for your installed version\n"
                "  if the snippet above doesn't take.)\n"
            ),
        },
    ]


def _try_register(spec, binp):
    """Attempt one client's add (after a silent remove). Returns
    (status, detail) where status is 'registered' or 'failed'."""
    _safely(subprocess.run, spec["remove_argv"](binp), capture_output=True)
    r = subprocess.run(spec["add_argv"](binp), capture_output=True, text=True)
    if r.returncode == 0:
        return "registered", None
    detail = (r.stderr or r.stdout or "").strip()
    # Trim long error blobs to one line for the status table
    first = detail.splitlines()[0] if detail else f"exit {r.returncode}"
    return "failed", first[:200]


def _try_unregister(spec, binp):
    r = subprocess.run(spec["remove_argv"](binp), capture_output=True, text=True)
    if r.returncode == 0:
        return "unregistered", None
    detail = (r.stderr or r.stdout or "").strip()
    first = detail.splitlines()[0] if detail else f"exit {r.returncode}"
    return "not-registered", first[:200]


def cmd_activate_mcp(argv):
    """Provision a venv with the `mcp` SDK and register termpilot with every
    MCP-capable client found on $PATH (Claude Code, Codex CLI, or both)."""
    p = argparse.ArgumentParser(
        prog="termpilot --activate-mcp",
        description="Set up the termpilot MCP server: create a Python venv "
                    "with the `mcp` PyPI package, then register the server "
                    "with every MCP-capable client found on $PATH (Claude "
                    "Code, Codex CLI, or both). Skips any client that's not "
                    "installed; reports per-client status. Idempotent - safe "
                    "to re-run any time (e.g. after install.sh).",
    )
    p.add_argument("--venv", default=MCP_VENV_DEFAULT,
                   help="path for the MCP server's venv "
                        f"(default: {MCP_VENV_DEFAULT})")
    p.add_argument("--scope", choices=("user", "local", "project"), default="user",
                   help="Claude Code MCP scope. user = machine-wide (default); "
                        "local = current directory only; project = checked-in "
                        ".mcp.json. Ignored by Codex CLI (uses its own scope model).")
    p.add_argument("--no-claude", action="store_true",
                   help="skip Claude Code registration even if `claude` is found.")
    p.add_argument("--no-codex", action="store_true",
                   help="skip Codex CLI registration even if `codex` is found.")
    p.add_argument("--reinstall", action="store_true",
                   help="reinstall the `mcp` package even if the venv already has it.")
    args = p.parse_args(argv)

    pkg_dir = _locate_termpilot_mcp()
    if not pkg_dir:
        sys.stderr.write(
            "error: termpilot_mcp/ not found next to the wrapper.\n"
            "  Looked at:\n"
            f"    {os.path.join(SCRIPT_DIR, 'termpilot_mcp')}\n"
            f"    {os.path.realpath(os.path.join(SCRIPT_DIR, '..', 'termpilot_mcp'))}\n"
            "  Re-run install.sh (dev tree) or install-latest-version.sh "
            "(release zip) to get the directory in place.\n"
        )
        return 1

    venv_python = os.path.join(args.venv, "bin", "python")
    venv_pip = os.path.join(args.venv, "bin", "pip")

    if os.path.exists(venv_python):
        print(f"venv already exists at {args.venv}")
    else:
        print(f"creating venv at {args.venv}")
        try:
            subprocess.run(
                [sys.executable, "-m", "venv", args.venv],
                check=True,
            )
        except (subprocess.CalledProcessError, FileNotFoundError) as e:
            sys.stderr.write(
                f"error: `python3 -m venv` failed: {e}\n"
                "  On Debian/Ubuntu/Zorin you may need: sudo apt install python3-venv\n"
            )
            return 1

    req_file = os.path.join(pkg_dir, "requirements.txt")
    pip_args = [venv_pip, "install", "--quiet", "-r", req_file]
    if args.reinstall:
        pip_args.insert(2, "--force-reinstall")
    print("installing the `mcp` Python SDK into the venv...")
    try:
        subprocess.run(pip_args, check=True)
    except subprocess.CalledProcessError as e:
        sys.stderr.write(f"error: pip install failed (exit {e.returncode})\n")
        return 1

    try:
        os.makedirs(os.path.dirname(MCP_ACTIVE_MARKER), exist_ok=True)
        with open(MCP_ACTIVE_MARKER, "w") as f:
            f.write(f"{int(time.time())}\n")
    except OSError as e:
        sys.stderr.write(f"warning: could not write {MCP_ACTIVE_MARKER}: {e}\n")

    wrap_real = os.path.realpath(__file__)
    specs = _mcp_client_specs(venv_python, wrap_real, args.scope)
    skip_names = set()
    if args.no_claude:
        skip_names.add("claude")
    if args.no_codex:
        skip_names.add("codex")

    print()
    print("MCP client registration:")
    found_any = False
    registered_any = False
    failed_specs = []
    for spec in specs:
        bin_name = spec["bin_name"]
        if bin_name in skip_names:
            print(f"  - {spec['name']}: skipped (--no-{bin_name})")
            continue
        binp = shutil.which(bin_name)
        if not binp:
            print(f"  - {spec['name']}: not found (`{bin_name}` not on $PATH)")
            continue
        found_any = True
        status, detail = _try_register(spec, binp)
        if status == "registered":
            print(f"  + {spec['name']}: registered{spec['scope_note']}")
            registered_any = True
        else:
            print(f"  ! {spec['name']}: registration failed - {detail or '(no error message)'}")
            failed_specs.append(spec)

    if failed_specs:
        print()
        print("Failed registrations: manual setup instructions")
        for spec in failed_specs:
            print(f"\n{spec['name']}:")
            sys.stdout.write(spec["manual_hint"])

    print()
    if not found_any:
        print("No MCP-capable client detected.")
        print("  Install Claude Code (https://claude.ai/code) or Codex CLI,")
        print("  then re-run `termpilot --activate-mcp`. The venv is ready;")
        print("  registration is the only step still pending.")
        return 0
    if not registered_any:
        print("Venv is ready, but no client registration succeeded.")
        print("  Use the manual setup hints above to wire termpilot in by hand.")
        return 0

    print("termpilot MCP activated.")
    print()
    print("Try it: open one of the registered clients and ask")
    print("  'are there any termpilot sessions running on this machine?'")
    print("Boss should call list_sessions unprompted.")
    print()
    print("Reverse with: termpilot --deactivate-mcp")
    return 0


def cmd_deactivate_mcp(argv):
    """Unregister termpilot from every MCP-capable client found on $PATH
    (and optionally remove its venv)."""
    p = argparse.ArgumentParser(
        prog="termpilot --deactivate-mcp",
        description="Remove termpilot from every MCP-capable client found "
                    "on $PATH (Claude Code, Codex CLI, or both). By default "
                    "the venv at ~/.local/share/termpilot/mcp-venv is left "
                    "in place (cheap to keep, instant to reactivate); pass "
                    "--purge to delete it too.",
    )
    p.add_argument("--scope", choices=("user", "local", "project"), default="user",
                   help="Claude Code scope to unregister from (default: user).")
    p.add_argument("--venv", default=MCP_VENV_DEFAULT,
                   help=f"venv path (default: {MCP_VENV_DEFAULT})")
    p.add_argument("--no-claude", action="store_true",
                   help="skip Claude Code unregistration.")
    p.add_argument("--no-codex", action="store_true",
                   help="skip Codex CLI unregistration.")
    p.add_argument("--purge", action="store_true",
                   help="also remove the venv directory.")
    args = p.parse_args(argv)

    venv_python = os.path.join(args.venv, "bin", "python")
    wrap_real = os.path.realpath(__file__)
    specs = _mcp_client_specs(venv_python, wrap_real, args.scope)
    skip_names = set()
    if args.no_claude:
        skip_names.add("claude")
    if args.no_codex:
        skip_names.add("codex")

    try:
        os.remove(MCP_ACTIVE_MARKER)
    except FileNotFoundError:
        pass
    except OSError as e:
        sys.stderr.write(f"warning: could not remove {MCP_ACTIVE_MARKER}: {e}\n")

    print("MCP client unregistration:")
    for spec in specs:
        bin_name = spec["bin_name"]
        if bin_name in skip_names:
            print(f"  - {spec['name']}: skipped (--no-{bin_name})")
            continue
        binp = shutil.which(bin_name)
        if not binp:
            print(f"  - {spec['name']}: not found (`{bin_name}` not on $PATH)")
            continue
        status, detail = _try_unregister(spec, binp)
        if status == "unregistered":
            print(f"  + {spec['name']}: unregistered")
        else:
            print(
                f"  - {spec['name']}: not registered (or remove failed)"
                + (f" - {detail}" if detail else "")
            )

    print()
    if args.purge:
        if os.path.isdir(args.venv):
            try:
                shutil.rmtree(args.venv)
                print(f"removed venv at {args.venv}")
            except OSError as e:
                sys.stderr.write(f"error: could not remove {args.venv}: {e}\n")
                return 1
        else:
            print(f"no venv to remove at {args.venv}")
    else:
        if os.path.isdir(args.venv):
            print(f"venv kept at {args.venv} (use --purge to delete)")

    return 0


# ============================================================================
#  Top-level dispatch
# ============================================================================


def main(argv=None):
    argv = list(argv if argv is not None else sys.argv[1:])

    # First positional arg = subcommand. Long-flag aliases are accepted so
    # the user-visible UI is `termpilot --generate-token` etc.
    if argv and argv[0] in ("help", "--help", "-h"):
        return cmd_help(argv[1:])
    if argv and argv[0] in ("generate-token", "--generate-token"):
        return cmd_generate_token(argv[1:])
    if argv and argv[0] in ("show-token", "--show-token"):
        return cmd_show_token(argv[1:])
    if argv and argv[0] in ("set-relay-url", "--set-relay-url"):
        return cmd_set_relay_url(argv[1:])
    if argv and argv[0] in ("get-relay-url", "--get-relay-url"):
        return cmd_get_relay_url(argv[1:])
    if argv and argv[0] in ("set-relay-secret", "--set-relay-secret"):
        return cmd_set_relay_secret(argv[1:])
    if argv and argv[0] in ("clear-relay-secret", "--clear-relay-secret"):
        return cmd_clear_relay_secret(argv[1:])
    if argv and argv[0] in ("version", "--version", "-V"):
        from shared import release_channel
        return release_channel.cmd_version(argv[1:], SCRIPT_DIR)
    if argv and argv[0] in ("update", "--update"):
        from shared import release_channel
        return release_channel.cmd_update(argv[1:], SCRIPT_DIR)
    if argv and argv[0] in ("test-connection", "--test-connection"):
        return cmd_test_connection(argv[1:])
    if argv and argv[0] in ("activate-mcp", "--activate-mcp"):
        return cmd_activate_mcp(argv[1:])
    if argv and argv[0] in ("deactivate-mcp", "--deactivate-mcp"):
        return cmd_deactivate_mcp(argv[1:])
    # termpilot_mcp subcommands; lazy-imported so they don't slow run-mode
    # startup. See termpilot_mcp/cli.py. We re-exec under the activate-mcp
    # venv first (if it exists) so `import mcp` / `import pyte` resolve
    # without the user juggling PYTHONPATH or interpreter paths.
    if argv and argv[0] in ("ls", "tail", "screenshot", "transcript", "gc",
                            "send", "wait", "mcp-serve"):
        _maybe_reexec_in_mcp_venv(argv)
        from termpilot_mcp import cli as _mcp_cli
        return _mcp_cli.main(argv)
    if argv and argv[0] == "run":
        return cmd_run(argv[1:])
    # No subcommand → run-mode (so `termpilot bash` works without `--`).
    return cmd_run(argv)


if __name__ == "__main__":
    try:
        rc = main()
    except KeyboardInterrupt:
        rc = 130
    sys.exit(rc)
