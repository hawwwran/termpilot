# ============================================================================
#  Resilience: cache layout, single-instance lock, active.json, output spool
# ============================================================================
#
# All persistent state lives under ~/.cache/termpilot/, organised so
# per-cwd things (lock + last-known sid for crash-recovery sid reuse) are
# separate from per-sid things (the encrypted/POST queue spool).
#
#   ~/.cache/termpilot/
#     cwd/<encoded-cwd>/
#       wrapper.lock          fcntl LOCK_EX held by the running wrapper
#       active.json           {wrapper_sid, ts, pid} — used for crash
#                              recovery (sid reuse within 5 min of crash)
#     sid/<sid>/
#       out.spool             append-only [u32 len][plaintext bytes] entries
#       out.cursor            uint64 LE byte offset; bytes before this have
#                              been confirmed delivered to the relay
#       out.next_seq          uint32 LE next AAD seq to assign at POST time
#
# Spool stores PLAINTEXT (not ciphertext). On the same machine the encryption
# key is in the OS keyring (or ~/.config/termpilot/token), which is plaintext-equivalent
# anyway, so the trust boundary is identical. Storing plaintext makes 409
# resync trivial — we just re-encrypt with the relay's expected_seq. Mode
# 0700 on the dir, 0600 on files; same as the keyring fallback.

CACHE_BASE = os.path.expanduser("~/.cache/termpilot")

# Structured event log. Always-on, one JSON record per line. Rotates to
# .1 once it grows past EVENT_LOG_MAX_BYTES; older rotations are dropped.
# Set TERMPILOT_DEBUG=1 to also mirror events to stderr in human-readable form.
# Read with: `tail -f ~/.cache/termpilot/events.log` or
#            `grep push_ ~/.cache/termpilot/events.log`
EVENT_LOG = os.path.join(CACHE_BASE, "events.log")
EVENT_LOG_MAX_BYTES = 256 * 1024


def log_event(cat: str, **fields) -> None:
    """Append a structured event. Best-effort; never raises."""
    try:
        os.makedirs(CACHE_BASE, mode=0o700, exist_ok=True)
    except OSError:
        return
    try:
        if os.path.exists(EVENT_LOG) and os.path.getsize(EVENT_LOG) > EVENT_LOG_MAX_BYTES:
            rot = EVENT_LOG + ".1"
            try: os.unlink(rot)
            except OSError: pass
            try: os.rename(EVENT_LOG, rot)
            except OSError: pass
    except OSError:
        pass
    rec = {
        "ts": time.strftime("%Y-%m-%dT%H:%M:%S", time.gmtime()) + "Z",
        "pid": os.getpid(),
        "cat": cat,
    }
    rec.update(fields)
    try:
        line = json.dumps(rec, separators=(",", ":"), default=str) + "\n"
    except Exception:
        return
    try:
        with open(EVENT_LOG, "a") as f:
            f.write(line)
        try: os.chmod(EVENT_LOG, 0o600)
        except OSError: pass
    except OSError:
        pass
    if os.environ.get("TERMPILOT_DEBUG"):
        try:
            sys.stderr.write(f"[{cat}] " + ", ".join(f"{k}={v}" for k, v in fields.items()) + "\n")
        except Exception:
            pass


def _encode_cwd(cwd: str) -> str:
    # Hash rather than regex-collapse: the prior `re.sub("[^a-zA-Z0-9-]", "-", cwd)`
    # was non-injective (cwds /a/b, /a-b, /a.b all mapped to "-a-b"), so two
    # different working directories could share an active.json — leaking
    # spool state from one project into another. SHA-256 truncated to 16
    # hex chars gives 64-bit collision space; overkill for the universe
    # of project paths a user has, but cheap.
    return hashlib.sha256(cwd.encode("utf-8")).hexdigest()[:16]


# Instance label = a second key alongside cwd, so multiple wrappers can
# coexist in the same working directory. Resolved at startup from
# (in order): --instance flag, $TERMPILOT_INSTANCE, controlling TTY of
# stdin (e.g. "pts-3"), or the literal "default" if none of the above
# yields a label. See resolve_instance().
_INSTANCE_LABEL_RE = re.compile(r"^[a-zA-Z0-9_.-]{1,64}$")


def _validate_instance_label(s: str, *, source: str) -> str:
    if s in (".", "..") or not _INSTANCE_LABEL_RE.fullmatch(s):
        raise ValueError(f"invalid instance label from {source}: {s!r}")
    return s


def resolve_instance(arg_value: str | None) -> str:
    """Pick the per-cwd resilience-slot label. See module-level rules above."""
    if arg_value:
        return _validate_instance_label(arg_value, source="--instance")
    env = os.environ.get("TERMPILOT_INSTANCE")
    if env:
        return _validate_instance_label(env, source="TERMPILOT_INSTANCE")
    try:
        tty = os.ttyname(0)            # /dev/pts/3, /dev/ttys003, ...
    except OSError:
        tty = None
    if tty:
        label = tty.removeprefix("/dev/").replace("/", "-")
        try:
            return _validate_instance_label(label, source="tty")
        except ValueError:
            log_event("instance_tty_unsanitary", tty=tty)
    return "default"


def cwd_cache_dir(cwd: str, instance: str) -> str:
    return os.path.join(CACHE_BASE, "cwd", _encode_cwd(cwd), instance)


def sid_cache_dir(sid: str) -> str:
    return os.path.join(CACHE_BASE, "sid", sid)


def acquire_wrapper_lock(cwd: str, instance: str) -> int | None:
    """fcntl LOCK_EX|LOCK_NB on <cwd-cache>/<instance>/wrapper.lock. Returns
    the open file descriptor (callers must keep it alive for the lifetime
    of the process) or None if another process holds the lock.
    """
    d = cwd_cache_dir(cwd, instance)
    try:
        os.makedirs(d, mode=0o700, exist_ok=True)
        try: os.chmod(d, 0o700)
        except OSError: pass
    except OSError as e:
        sys.stderr.write(f"termpilot: cannot create cache dir {d}: {e}\n")
        return None
    lock_path = os.path.join(d, "wrapper.lock")
    # O_CLOEXEC: the pty-forked child must NOT inherit this fd.
    # On Linux flock state is per-open-file-description, so a duplicate
    # fd in the child keeps the lock alive — even after the wrapper
    # exits via SIGKILL, the orphaned child (reparented to init) would
    # keep the lock held until it eventually exits, blocking any new
    # `termpilot` in the same cwd in the meantime.
    #
    # O_NOFOLLOW: refuse to open if lock_path is a symlink. The parent
    # dir is mode 0700, so under normal use only this process's user
    # could plant one — but on a system where the dir mode wasn't
    # enforced this would otherwise hand a local attacker the ability
    # to write the wrapper PID into a file of their choosing.
    try:
        fd = os.open(lock_path, os.O_RDWR | os.O_CREAT | os.O_CLOEXEC | os.O_NOFOLLOW, 0o600)
    except OSError as e:
        sys.stderr.write(f"termpilot: cannot open lock file {lock_path}: {e}\n")
        return None
    try:
        fcntl.flock(fd, fcntl.LOCK_EX | fcntl.LOCK_NB)
    except OSError:
        os.close(fd)
        return None
    # Record our PID inside the lock file as a debugging aid (the lock is
    # advisory; this is just helpful when the user is diagnosing).
    try:
        os.ftruncate(fd, 0)
        os.write(fd, f"{os.getpid()}\n".encode())
    except OSError:
        pass
    return fd


def release_wrapper_lock(fd: int | None) -> None:
    if fd is None:
        return
    try:
        fcntl.flock(fd, fcntl.LOCK_UN)
    except OSError:
        pass
    try:
        os.close(fd)
    except OSError:
        pass


def read_active_json(cwd: str, instance: str) -> dict:
    p = os.path.join(cwd_cache_dir(cwd, instance), "active.json")
    try:
        with open(p, "r") as f:
            d = json.load(f)
        return d if isinstance(d, dict) else {}
    except (OSError, ValueError):
        return {}


def write_active_json(cwd: str, instance: str, **fields) -> None:
    d = cwd_cache_dir(cwd, instance)
    try:
        os.makedirs(d, mode=0o700, exist_ok=True)
    except OSError:
        return
    p = os.path.join(d, "active.json")
    obj = read_active_json(cwd, instance)
    obj.update(fields)
    obj["ts"] = int(time.time())
    obj["pid"] = os.getpid()
    tmp = p + ".tmp"
    try:
        with open(tmp, "w") as f:
            json.dump(obj, f)
            f.flush()
            try: os.fsync(f.fileno())
            except OSError: pass
        os.replace(tmp, p)
        try: os.chmod(p, 0o600)
        except OSError: pass
    except OSError:
        pass


def clear_active_json(cwd: str, instance: str) -> None:
    p = os.path.join(cwd_cache_dir(cwd, instance), "active.json")
    try:
        os.unlink(p)
    except OSError:
        pass


def _proc_cmdline(pid: int) -> str | None:
    # /proc on Linux; on macOS fall back to `ps`. Either yields a single
    # joined string or None (no such pid / not permitted).
    try:
        with open(f"/proc/{pid}/cmdline", "rb") as f:
            raw = f.read()
        return " ".join(p.decode("utf-8", "replace") for p in raw.split(b"\0") if p)
    except OSError:
        pass
    try:
        import subprocess
        r = subprocess.run(
            ["ps", "-p", str(pid), "-o", "command="],
            capture_output=True, text=True, timeout=2,
        )
        if r.returncode == 0:
            line = r.stdout.strip()
            return line or None
    except Exception:
        pass
    return None


def _proc_cwd(pid: int) -> str | None:
    try:
        return os.readlink(f"/proc/{pid}/cwd")
    except OSError:
        pass
    # macOS: no /proc, no portable cwd reader without lsof. Skip — the row
    # still prints with the cwd-hash fallback.
    return None


def _proc_is_alive(pid: int) -> bool:
    if pid <= 0:
        return False
    try:
        os.kill(pid, 0)
        return True
    except (ProcessLookupError, PermissionError, OSError):
        return False


def _is_wrapper_run(cmdline: str | None) -> bool:
    """True iff cmdline looks like a termpilot wrapper running a session
    (excludes --test-connection, --generate-token, etc.)."""
    if not cmdline or "termpilot-wrap" not in cmdline:
        return False
    parts = cmdline.split()
    try:
        i = next(i for i, p in enumerate(parts) if "termpilot-wrap" in p)
    except StopIteration:
        return False
    after = parts[i + 1:]
    if not after:
        return False
    return after[0] == "run"


def collect_wrapper_inventory(self_pid: int | None = None) -> list[dict]:
    """Enumerate active.json entries plus any live wrappers without one.
    No network calls; purely /proc + ~/.cache walk."""
    if self_pid is None:
        self_pid = os.getpid()
    rows = []
    matched_pids = set()
    base = os.path.join(CACHE_BASE, "cwd")
    if os.path.isdir(base):
        try:
            hashes = os.listdir(base)
        except OSError:
            hashes = []
        for h in hashes:
            hdir = os.path.join(base, h)
            if not os.path.isdir(hdir):
                continue
            try:
                instances = os.listdir(hdir)
            except OSError:
                continue
            for inst in instances:
                idir = os.path.join(hdir, inst)
                p = os.path.join(idir, "active.json")
                if not os.path.isfile(p):
                    continue
                try:
                    with open(p) as f:
                        obj = json.load(f)
                except (OSError, ValueError):
                    continue
                pid = int(obj.get("pid") or 0)
                sid = obj.get("wrapper_sid") or ""
                ts  = int(obj.get("ts") or 0)
                cmdline = _proc_cmdline(pid) if pid else None
                # If we can read the cmdline, verify it's still a wrapper
                # (defends against PID reuse). If we can't (macOS, denied,
                # etc.), trust os.kill(pid,0): worst case we mislabel a
                # recycled PID, which is harmless cache-display drift.
                if cmdline is not None:
                    alive = _is_wrapper_run(cmdline)
                else:
                    alive = _proc_is_alive(pid)
                cwd_path = _proc_cwd(pid) if alive else None
                if alive:
                    matched_pids.add(pid)
                rows.append({
                    "pid": pid, "sid": sid, "ts": ts, "alive": alive,
                    "instance": inst, "cwd_hash": h,
                    "cwd": cwd_path, "cmdline": cmdline,
                    "from_cache": True,
                })
    try:
        pid_dirs = os.listdir("/proc")
    except OSError:
        pid_dirs = []
    for name in pid_dirs:
        if not name.isdigit():
            continue
        pid = int(name)
        if pid == self_pid or pid in matched_pids:
            continue
        cmdline = _proc_cmdline(pid)
        if not _is_wrapper_run(cmdline):
            continue
        rows.append({
            "pid": pid, "sid": "", "ts": 0, "alive": True,
            "instance": "?", "cwd_hash": "",
            "cwd": _proc_cwd(pid), "cmdline": cmdline,
            "from_cache": False,
        })
    return rows


def _format_age(secs: float) -> str:
    if secs < 0:
        return "—"
    if secs < 90:
        return f"{int(secs)}s"
    if secs < 3600:
        return f"{int(secs // 60)}m"
    if secs < 86400:
        h = int(secs // 3600); m = int((secs % 3600) // 60)
        return f"{h}h{m:02d}m"
    d = int(secs // 86400); h = int((secs % 86400) // 3600)
    return f"{d}d{h:02d}h"


def render_wrapper_inventory(out=sys.stdout) -> None:
    """Print the local-wrapper inventory to `out`. Used by --test-connection."""
    rows = collect_wrapper_inventory()
    use_color = hasattr(out, "isatty") and out.isatty()

    def col(s: str, code: str) -> str:
        return f"\033[{code}m{s}\033[0m" if use_color else s

    running = sum(1 for r in rows if r["alive"])
    cached  = sum(1 for r in rows if r["from_cache"])
    stale   = sum(1 for r in rows if r["from_cache"] and not r["alive"])

    if running >= 10:
        running_str = col(str(running), "1;31")
        warn = "  HIGH — risky on small FPM pools; close terminals you don't need"
    elif running >= 5:
        running_str = col(str(running), "1;33")
        warn = "  moderate — watch this if relay latency climbs"
    else:
        running_str = col(str(running), "1;32")
        warn = ""

    out.write("\nLocal wrappers:\n")
    out.write(f"  running: {running_str}{warn}\n")
    out.write(f"  cached:  {cached} (stale: {stale})\n")
    if not rows:
        return

    rows.sort(key=lambda r: (not r["alive"], -(r["ts"] or 0)))
    alive_rows = [r for r in rows if r["alive"]]
    stale_rows = [r for r in rows if not r["alive"]]
    STALE_SHOW = 10
    stale_shown = stale_rows[:STALE_SHOW]
    stale_hidden = len(stale_rows) - len(stale_shown)
    now = int(time.time())

    def _row(r):
        age = _format_age(now - r["ts"]) if r["ts"] else "—"
        state = "ALIVE" if r["alive"] else "stale"
        state_disp = col(f"{state:<6}", "32" if r["alive"] else "31")
        pid_s = str(r["pid"]) if r["pid"] else "—"
        sid = (r["sid"] or "—")[:14]
        instance = (r["instance"] or "—")[:10]
        if r["cwd"]:
            where = r["cwd"]
        elif r["cwd_hash"]:
            where = f"(hash {r['cwd_hash'][:8]})"
        else:
            where = "—"
        cmd_tail = ""
        if r["cmdline"]:
            parts = r["cmdline"].split()
            try:
                i = next(i for i, p in enumerate(parts) if "termpilot-wrap" in p)
                tail = parts[i + 1:]
                if tail and tail[0] == "run":
                    tail = tail[1:]
                cmd_tail = " ".join(tail)
            except StopIteration:
                pass
        line_right = where
        if cmd_tail:
            line_right += f"   {cmd_tail}"
        if len(line_right) > 72:
            line_right = line_right[:71] + "…"
        out.write(
            f"  {pid_s:>7}  {instance:<10} {sid:<14} {age:>6}  "
            f"{state_disp} {line_right}\n"
        )

    out.write(
        f"\n  {'PID':>7}  {'Instance':<10} {'Sid':<14} {'Age':>6}  "
        f"{'State':<6} Where\n"
    )
    for r in alive_rows:
        _row(r)
    for r in stale_shown:
        _row(r)
    if stale_hidden > 0:
        out.write(f"  … {stale_hidden} older stale entries hidden\n")
    if running >= 5:
        out.write(
            "\n  Tip: to find the terminal owning a wrapper, look up its PID's parent\n"
            "       process — e.g.  ps -o pid,ppid,args -p <PID>  then  ps <PPID>\n"
            "       Close that terminal (or SIGTERM the wrapper) to free the FPM slot.\n"
        )


def cleanup_stale_sid_dirs(keep_sid: str, max_age_secs: int = 7 * 24 * 3600) -> None:
    """Delete spool dirs older than max_age_secs (besides keep_sid). Non-fatal
    on any error — this is housekeeping, not core function."""
    base = os.path.join(CACHE_BASE, "sid")
    if not os.path.isdir(base):
        return
    # Defense-in-depth: under 0700 perms a non-owner can't plant a symlink
    # here, but if one ever appeared, shutil.rmtree would refuse a link at
    # the root and we'd skip it anyway. The realpath check makes intent
    # explicit and mirrors the relay's op_gc sanity check.
    try:
        real_base = os.path.realpath(base)
    except OSError:
        return
    now = time.time()
    try:
        names = os.listdir(base)
    except OSError:
        return
    for name in names:
        if name == keep_sid:
            continue
        d = os.path.join(base, name)
        try:
            real_d = os.path.realpath(d)
        except OSError:
            continue
        if real_d != real_base and not real_d.startswith(real_base + os.sep):
            continue
        try:
            if now - os.path.getmtime(d) <= max_age_secs:
                continue
        except OSError:
            continue
        try:
            shutil.rmtree(d)
        except OSError:
            pass


def cleanup_legacy_cwd_artifacts(max_age_secs: int = 7 * 24 * 3600) -> None:
    """Pre-instance layout left active.json + wrapper.lock directly in
    cwd/<hash>/. The new layout nests them under cwd/<hash>/<instance>/.
    Sweep leftover files older than max_age_secs so the dir doesn't
    accumulate forever. Best-effort, never raises."""
    base = os.path.join(CACHE_BASE, "cwd")
    if not os.path.isdir(base):
        return
    now = time.time()
    try:
        hashes = os.listdir(base)
    except OSError:
        return
    for h in hashes:
        d = os.path.join(base, h)
        for fname in ("active.json", "wrapper.lock"):
            p = os.path.join(d, fname)
            if not os.path.isfile(p):
                continue
            try:
                if now - os.path.getmtime(p) <= max_age_secs:
                    continue
            except OSError:
                continue
            try: os.unlink(p)
            except OSError: pass


class OutputSpool:
    """Append-only durable queue of PTY chunks awaiting encryption + POST.

    Survives wrapper SIGKILL between PTY-read and confirmed-POST: bytes
    captured here are recoverable on next start as long as the same sid
    is reused. Reusing a sid only happens on crash recovery (active.json
    age < CRASH_RECOVERY_SECS); otherwise a fresh sid is assigned and the
    old spool is left to be GC'd by cleanup_stale_sid_dirs.

    Files (under sid_cache_dir(sid)):
      <stream>.spool      append-only [uint32 LE len][plain_bytes] entries
      <stream>.cursor     uint64 LE byte offset; bytes before confirmed sent
      <stream>.next_seq   uint32 LE next AAD seq to assign at POST time

    Threading: append/confirm_through/write_next_seq are called from the
    single uploader thread. pending_chunks is called once at startup.
    """
    HDR = struct.Struct("<I")

    def __init__(self, sid: str, stream: str):
        d = sid_cache_dir(sid)
        os.makedirs(d, mode=0o700, exist_ok=True)
        try: os.chmod(d, 0o700)
        except OSError: pass
        self.sid = sid
        self.stream = stream
        self._spool_path = os.path.join(d, f"{stream}.spool")
        self._cursor_path = os.path.join(d, f"{stream}.cursor")
        self._seq_path = os.path.join(d, f"{stream}.next_seq")
        if not os.path.exists(self._spool_path):
            with open(self._spool_path, "wb"):
                pass
            try: os.chmod(self._spool_path, 0o600)
            except OSError: pass
        self._fh = open(self._spool_path, "ab")
        self._fh.seek(0, 2)
        self._size = self._fh.tell()

    def append(self, plain: bytes) -> int:
        """Write a plaintext chunk; return new spool size (== entry end offset)."""
        self._fh.write(self.HDR.pack(len(plain)))
        self._fh.write(plain)
        self._fh.flush()
        try: os.fsync(self._fh.fileno())
        except OSError: pass
        self._size += 4 + len(plain)
        return self._size

    def cursor(self) -> int:
        try:
            with open(self._cursor_path, "rb") as f:
                d = f.read(8)
            return int.from_bytes(d, "little") if len(d) == 8 else 0
        except OSError:
            return 0

    def write_cursor(self, off: int) -> None:
        tmp = self._cursor_path + ".tmp"
        try:
            with open(tmp, "wb") as f:
                f.write(off.to_bytes(8, "little"))
                f.flush()
                try: os.fsync(f.fileno())
                except OSError: pass
            os.replace(tmp, self._cursor_path)
            try: os.chmod(self._cursor_path, 0o600)
            except OSError: pass
        except OSError:
            pass

    def confirm_through(self, off: int) -> None:
        if off > self.cursor():
            self.write_cursor(off)

    def next_seq(self) -> int:
        try:
            with open(self._seq_path, "rb") as f:
                d = f.read(4)
            return int.from_bytes(d, "little") if len(d) == 4 else 0
        except OSError:
            return 0

    def write_next_seq(self, n: int) -> None:
        tmp = self._seq_path + ".tmp"
        try:
            with open(tmp, "wb") as f:
                f.write(n.to_bytes(4, "little"))
                f.flush()
                try: os.fsync(f.fileno())
                except OSError: pass
            os.replace(tmp, self._seq_path)
            try: os.chmod(self._seq_path, 0o600)
            except OSError: pass
        except OSError:
            pass

    def pending_chunks(self) -> list[dict]:
        """Read entries past cursor. Returns [{plain, end_off}, ...]."""
        out: list[dict] = []
        cur = self.cursor()
        try:
            with open(self._spool_path, "rb") as f:
                f.seek(cur)
                while True:
                    h = f.read(4)
                    if len(h) < 4:
                        break
                    n = self.HDR.unpack(h)[0]
                    p = f.read(n)
                    if len(p) < n:
                        # Truncated tail (interrupted append). Discard.
                        break
                    end_off = f.tell()
                    out.append({"plain": p, "end_off": end_off})
        except OSError:
            pass
        return out

    def truncate(self) -> None:
        """Discard all spool contents. Cursor is reset to 0. Next-seq is
        preserved (we don't want to recycle seqs; that would break the
        relay's strict-order check)."""
        try:
            self._fh.close()
        except OSError:
            pass
        try:
            with open(self._spool_path, "wb"):
                pass
            try: os.chmod(self._spool_path, 0o600)
            except OSError: pass
        except OSError:
            pass
        self._fh = open(self._spool_path, "ab")
        self._size = 0
        self.write_cursor(0)

    def close(self) -> None:
        try: self._fh.close()
        except OSError: pass


# How long after a wrapper exits (or crashes) we still consider the previous
# sid+spool "fresh enough" to reuse. Picked generously: a wrapper might be
# offline for a few minutes during a network outage.
CRASH_RECOVERY_SECS = 5 * 60


