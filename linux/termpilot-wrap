def parse_run_args(argv):
    p = argparse.ArgumentParser(prog="termpilot", add_help=False, allow_abbrev=False)
    p.add_argument("--relay", default=os.environ.get("TERMPILOT_RELAY"))
    p.add_argument("--auth", default=None,
                   help="Bearer secret for the relay (fallback: $TERMPILOT_SECRET, "
                        "then ~/.config/termpilot/relay-secret).")
    p.add_argument("--title", default=None)
    p.add_argument("--no-local", action="store_true")
    p.add_argument("--no-local-input", action="store_true",
                   help="don't read sibling-process input from "
                        "~/.cache/termpilot/sid/<sid>/in.local (used by "
                        "termpilot_mcp / `tp send` for same-machine orchestration).")
    p.add_argument("--insecure", action="store_true",
                   help="skip TLS cert verification (for local dev with php -S)")
    p.add_argument("--force", action="store_true",
                   help="run even if another wrapper appears to hold the per-cwd lock")
    p.add_argument("--instance", default=None,
                   help="resilience-slot label within this cwd. Default: derived "
                        "from the controlling TTY (e.g. 'pts-3'); $TERMPILOT_INSTANCE "
                        "wins over TTY; --instance wins over both. Charset "
                        "[a-zA-Z0-9_.-], length 1-64.")
    p.add_argument("-h", "--help", action="store_true")
    args, rest = p.parse_known_args(argv)
    if rest and rest[0] == "--":
        rest = rest[1:]
    return args, rest


def cmd_test_connection(argv):
    p = argparse.ArgumentParser(prog="termpilot --test-connection", add_help=True,
                                allow_abbrev=False)
    p.add_argument("--relay", default=os.environ.get("TERMPILOT_RELAY"))
    p.add_argument("--auth", default=None,
                   help="Bearer secret for the relay (fallback: $TERMPILOT_SECRET, "
                        "then ~/.config/termpilot/relay-secret).")
    p.add_argument("--insecure", action="store_true",
                   help="skip TLS cert verification")
    p.add_argument("--ping-count", type=int, default=10)
    p.add_argument("--fs-count", type=int, default=3)
    args = p.parse_args(argv)

    base = args.relay
    if not base:
        try:
            with open(RELAY_URL_FILE, "r") as f:
                base = f.read().strip()
        except OSError:
            pass
    if not base:
        sys.stderr.write(
            "termpilot: no relay URL configured.\n"
            "  Set one with:  termpilot --set-relay-url https://your.host/path\n"
        )
        return 2

    secret = _resolve_auth_secret(args.auth) or ""
    # Print the local-wrapper inventory first: it's purely local (no
    # network) and answers "what's my load on the relay?" instantly,
    # before the network probes that may stall for many seconds on a
    # bad link. flush() so the user sees it even if a later probe hangs.
    try:
        render_wrapper_inventory()
        sys.stdout.write("\n")
        sys.stdout.flush()
    except Exception as e:
        sys.stderr.write(f"  (wrapper inventory failed: {e})\n")
    from shared import connection_test
    return connection_test.run(
        base, secret,
        insecure=args.insecure,
        ping_count=args.ping_count,
        fs_count=args.fs_count,
    )


def _resolve_auth_secret(arg_value: str | None) -> str | None:
    if arg_value:
        return arg_value
    env = os.environ.get("TERMPILOT_SECRET")
    if env:
        return env
    p = SECRET_FILE
    import stat as _stat
    # O_NOFOLLOW: refuse to open a symlink at this path. The parent dir
    # is mode 0700, so only the user themselves could plant one — but
    # without the flag, os.stat() + open() would happily traverse a link
    # to e.g. a 0600 system file and return its contents. fstat() on the
    # opened fd then checks perms on the actual inode (no TOCTOU between
    # the perms check and the read).
    try:
        fd = os.open(p, os.O_RDONLY | os.O_NOFOLLOW)
    except FileNotFoundError:
        return None
    except OSError as e:
        if e.errno == errno.ELOOP:
            sys.stderr.write(
                f"WARNING: {p} is a symlink; refusing to load. "
                f"Remove and re-run --set-relay-secret.\n"
            )
        return None
    try:
        st = os.fstat(fd)
        if st.st_mode & (_stat.S_IRWXG | _stat.S_IRWXO):
            sys.stderr.write(
                f"WARNING: {p} has loose permissions "
                f"({oct(_stat.S_IMODE(st.st_mode))}); refusing to load. "
                f"Run: chmod 600 {p}\n"
            )
            return None
        return os.read(fd, 65536).decode("utf-8").strip()
    except OSError:
        return None
    finally:
        try: os.close(fd)
        except OSError: pass


def get_winsize(fd: int) -> bytes:
    try:
        return fcntl.ioctl(fd, termios.TIOCGWINSZ, b"\0" * 8)
    except OSError:
        return struct.pack("HHHH", 24, 80, 0, 0)


def set_winsize(fd: int, ws: bytes) -> None:
    try:
        fcntl.ioctl(fd, termios.TIOCSWINSZ, ws)
    except OSError:
        pass


def cols_rows_of(fd: int) -> tuple[int, int]:
    try:
        ws = fcntl.ioctl(fd, termios.TIOCGWINSZ, b"\0" * 8)
        rows, cols, _, _ = struct.unpack("HHHH", ws)
        return (cols if cols > 0 else 80, rows if rows > 0 else 24)
    except OSError:
        return (80, 24)


