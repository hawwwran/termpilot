def _qrencode_install_command() -> list[str] | None:
    """Return the platform-appropriate install command for qrencode,
    or None if we don't have a known recipe for this system."""
    if sys.platform == "darwin":
        if shutil.which("brew"):
            return ["brew", "install", "qrencode"]
        return None
    if sys.platform.startswith("linux"):
        if shutil.which("apt-get"):
            return ["sudo", "apt-get", "install", "-y", "qrencode"]
        if shutil.which("dnf"):
            return ["sudo", "dnf", "install", "-y", "qrencode"]
        if shutil.which("pacman"):
            return ["sudo", "pacman", "-S", "--noconfirm", "qrencode"]
    return None


def _offer_install_qrencode() -> str | None:
    """If qrencode is missing, explain what it's for and offer to install
    it. Returns the resolved qrencode path on success, or None to skip
    rendering the QR."""
    install_cmd = _qrencode_install_command()
    if install_cmd is None:
        sys.stdout.write(
            "(install `qrencode` for a scannable QR — package "
            "`qrencode` in your distro's repos)\n\n"
        )
        return None
    sys.stdout.write(
        "`qrencode` is not installed. With it, termpilot can render the\n"
        "token above as a scannable QR code — handy for moving the token\n"
        "onto another device (a phone scanner in the web UI is planned).\n"
    )
    sys.stdout.write(f"Install command: {' '.join(install_cmd)}\n")
    if not _confirm("Install qrencode now?", default_no=False):
        sys.stdout.write("\n")
        return None
    try:
        rc = subprocess.call(install_cmd)
    except OSError as e:
        sys.stderr.write(f"install failed: {e}\n\n")
        return None
    if rc != 0:
        sys.stderr.write(f"install command exited with code {rc}; skipping QR.\n\n")
        return None
    qrencode = shutil.which("qrencode")
    if qrencode is None:
        sys.stderr.write("qrencode still not on PATH after install; skipping QR.\n\n")
        return None
    sys.stdout.write("\n")
    return qrencode


def _render_qr_truecolor(hex_str: str, qrencode_path: str) -> str | None:
    """Render a scannable QR on stdout using 24-bit color escapes.

    qrencode's `-t ANSIUTF8` uses 8-color ANSI (`\\e[40m` / `\\e[47m`),
    which many terminal themes remap to theme-fg / theme-bg. On a dark
    theme that often makes the quiet zone the same colour as the
    terminal background, so phone QR readers see no margin around the
    finder patterns and stricter decoders (notably jsQR in the web UI)
    fail to lock on. We instead pull the raw matrix via `-t ASCII`,
    then re-emit it with explicit `\\e[38;2;R;G;Bm` / `\\e[48;2;R;G;Bm`
    so it renders pure black-on-white regardless of the active theme.
    Uses the upper-half-block char `▀` to fit two QR rows per terminal
    line — same compact aspect ratio as ANSIUTF8.
    """
    try:
        r = subprocess.run(
            [qrencode_path, "-t", "ASCII", "-m", "4", "-l", "H", hex_str],
            capture_output=True, text=True, timeout=5,
        )
    except (OSError, subprocess.SubprocessError):
        return None
    if r.returncode != 0 or not r.stdout:
        return None

    # ASCII output: 2 chars per QR module ('##' dark, '  ' light).
    rows: list[list[bool]] = []
    for line in r.stdout.splitlines():
        if not line:
            continue
        width_mod = len(line) // 2
        row = [line[i * 2] != " " for i in range(width_mod)]
        if row:
            rows.append(row)
    if not rows:
        return None

    width = len(rows[0])
    if len(rows) % 2 != 0:
        rows.append([False] * width)

    BLACK = "0;0;0"
    WHITE = "255;255;255"

    out_lines: list[str] = []
    for i in range(0, len(rows), 2):
        top, bot = rows[i], rows[i + 1]
        parts: list[str] = []
        last_pair: tuple[str, str] | None = None
        for c in range(width):
            fg = BLACK if top[c] else WHITE
            bg = BLACK if bot[c] else WHITE
            pair = (fg, bg)
            if pair != last_pair:
                parts.append(f"\033[38;2;{fg};48;2;{bg}m")
                last_pair = pair
            parts.append("▀")
        parts.append("\033[0m")
        out_lines.append("".join(parts))
    return "\n".join(out_lines) + "\n"


def _print_token_qr(hex_str: str):
    """Render the token as a scannable QR on stdout when possible.

    Skips when stdout isn't a TTY (piping/redirection shouldn't see ANSI
    escapes). When `qrencode` isn't present, offers to install it via
    the platform package manager.
    """
    if not sys.stdout.isatty():
        return
    qrencode = shutil.which("qrencode") or _offer_install_qrencode()
    if qrencode is None:
        return
    rendered = _render_qr_truecolor(hex_str, qrencode)
    if rendered is None:
        return
    sys.stdout.write(rendered)
    sys.stdout.write("\n")


