# ============================================================================


def cmd_show_token(args):
    stored = keystore.load_token()
    if stored is None:
        sys.stderr.write(
            "No token stored. Run `termpilot --generate-token` to create one.\n"
        )
        return 1
    if not require_sudo():
        sys.stderr.write("authentication failed; aborting\n")
        return 3

    hex_str = crypto.token_to_hex(stored)
    sys.stdout.write("\n")
    sys.stdout.write(f"Token (from {keystore.backend_in_use()}):\n")
    sys.stdout.write(f"  {hex_str}\n\n")
    _print_token_qr(hex_str)
    return 0


# ============================================================================
#  Subcommands: set-relay-url, get-relay-url
# ============================================================================
#
# Persist the relay URL at ~/.config/termpilot/relay-url so the user
# doesn't have to keep passing $TERMPILOT_RELAY. The shell function reads this
# file and exports TERMPILOT_RELAY for the run subcommand. Plain text, mode
# 0644 — the URL itself isn't secret (the bearer secret lives in
# relay-secret with mode 0600, separately).

RELAY_URL_FILE = os.path.expanduser("~/.config/termpilot/relay-url")


def _validate_relay_url(url: str) -> str | None:
    """Return None if the URL looks plausible, else an error message."""
    s = (url or "").strip()
    if not s:
        return "URL cannot be empty"
    if not (s.startswith("http://") or s.startswith("https://")):
        return "URL must start with http:// or https://"
    if " " in s or "\n" in s:
        return "URL must not contain whitespace"
    return None


def _normalize_relay_base(url: str) -> str:
    """Strip a trailing /relay.php (or /relay.php/) and any trailing slash so
    the stored value is always the directory holding relay.php.
    Accepts either form from --set-relay-url, --relay, or $TERMPILOT_RELAY."""
    s = (url or "").strip().rstrip("/")
    if s.endswith("/relay.php"):
        s = s[: -len("/relay.php")]
    return s


def _relay_endpoints(base: str) -> tuple[str, str]:
    """Given a normalized base URL, return (relay_url, transcript_url).

    transcript.php was retired when the chat view was merged into the
    terminal view; the returned transcript_url is unused and kept only
    so the tuple shape doesn't churn through every call site."""
    base = base.rstrip("/")
    return base + "/relay.php", base + "/relay.php"


def cmd_set_relay_url(args):
    if not args:
        sys.stderr.write(
            "Usage: termpilot --set-relay-url <https://your.host/path>\n"
        )
        return 2
    url = _normalize_relay_base(args[0])
    err = _validate_relay_url(url)
    if err:
        sys.stderr.write(f"termpilot: bad URL — {err}\n")
        return 2
    d = os.path.dirname(RELAY_URL_FILE)
    try:
        os.makedirs(d, mode=0o700, exist_ok=True)
    except OSError as e:
        sys.stderr.write(f"termpilot: cannot create {d}: {e}\n")
        return 1
    tmp = RELAY_URL_FILE + ".tmp"
    try:
        with open(tmp, "w") as f:
            f.write(url + "\n")
        os.replace(tmp, RELAY_URL_FILE)
        try: os.chmod(RELAY_URL_FILE, 0o644)
        except OSError: pass
    except OSError as e:
        sys.stderr.write(f"termpilot: cannot write {RELAY_URL_FILE}: {e}\n")
        return 1
    sys.stdout.write(f"Saved {RELAY_URL_FILE}: {url}\n")
    return 0


def cmd_get_relay_url(args):
    try:
        with open(RELAY_URL_FILE, "r") as f:
            url = f.read().strip()
    except OSError:
        sys.stderr.write(
            "No relay URL configured.\n"
            "Set one with:\n"
            "  termpilot --set-relay-url https://your.host/path\n"
        )
        return 1
    if not url:
        sys.stderr.write("Relay URL file exists but is empty.\n")
        return 1
    sys.stdout.write(url + "\n")
    return 0


# ============================================================================
#  Subcommands: set-relay-secret, clear-relay-secret
# ============================================================================
#
# The "server secret" is the relay's Bearer token (RELAY_SECRET in
# config.php) — an HTTP gate against drive-by spam. Distinct from the
# device encryption token. Stored at ~/.config/termpilot/relay-secret
# with mode 0600; the wrapper refuses to read it if perms are looser.

SECRET_FILE = os.path.expanduser("~/.config/termpilot/relay-secret")


def cmd_set_relay_secret(args):
    if not args or not args[0]:
        sys.stderr.write(
            "Usage: termpilot --set-relay-secret <SECRET>\n"
            "  The value must match RELAY_SECRET in your config.php.\n"
        )
        return 2
    secret = args[0].strip()
    if not secret:
        sys.stderr.write("termpilot: secret cannot be empty\n")
        return 2
    if any(c.isspace() for c in secret):
        sys.stderr.write("termpilot: secret must not contain whitespace\n")
        return 2
    d = os.path.dirname(SECRET_FILE)
    try:
        os.makedirs(d, mode=0o700, exist_ok=True)
        try: os.chmod(d, 0o700)
        except OSError: pass
    except OSError as e:
        sys.stderr.write(f"termpilot: cannot create {d}: {e}\n")
        return 1
    tmp = SECRET_FILE + ".tmp"
    try:
        # Write via os.open with O_CREAT|O_WRONLY|O_TRUNC mode 0600 so the
        # file is never world/group-readable, even briefly.
        fd = os.open(tmp, os.O_WRONLY | os.O_CREAT | os.O_TRUNC | os.O_NOFOLLOW, 0o600)
        try:
            os.write(fd, secret.encode("utf-8"))
        finally:
            os.close(fd)
        os.chmod(tmp, 0o600)
        os.replace(tmp, SECRET_FILE)
        os.chmod(SECRET_FILE, 0o600)
    except OSError as e:
        try: os.unlink(tmp)
        except OSError: pass
        sys.stderr.write(f"termpilot: cannot write {SECRET_FILE}: {e}\n")
        return 1
    sys.stdout.write(f"Saved {SECRET_FILE} (chmod 600).\n")
    return 0


def cmd_clear_relay_secret(args):
    try:
        os.unlink(SECRET_FILE)
        sys.stdout.write(f"Removed {SECRET_FILE}.\n")
        return 0
    except FileNotFoundError:
        sys.stdout.write(f"No secret file at {SECRET_FILE} — nothing to do.\n")
        return 0
    except OSError as e:
        sys.stderr.write(f"termpilot: cannot remove {SECRET_FILE}: {e}\n")
        return 1


